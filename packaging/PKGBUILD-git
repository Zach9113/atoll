# Maintainer: jojo2k7
# Contributor: Zach9113
#
# Development package built from the Zach9113/atoll fork, branch zach-patches:
# upstream Atoll plus a 12-hour clock without am/pm and `atollctl dodge`.
pkgname=atoll-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="A dynamic island for KDE Plasma (development version, zach-patches)"
arch=('x86_64' 'aarch64')
url="https://github.com/atoll-shell/atoll"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'layer-shell-qt' 'kcoreaddons' 'ki18n' 'dbus' 'wayland')
makedepends=('git' 'cmake' 'ninja' 'qt6-shadertools' 'extra-cmake-modules' 'wayland')
optdepends=('claude-code: the assistant, signed in with your own account instead of an API key'
            'cranked-audio: per-app volume mixer card right inside the island'
            'cava: real spectrum analysis instead of the synthetic one'
            'wireplumber: volume control from the island'
            'kde-cli-tools: launching apps from notifications'
            'polkit: let the assistant ask for administrator rights'
            'polkit-kde-agent: the dialog that asks for them, on Plasma'
            'libsecret: keep an assistant API key in your keyring instead of a file'
            'xdg-desktop-portal-kde: let the assistant look at your screen')
provides=('atoll')
conflicts=('atoll')
source=("atoll::git+https://github.com/Zach9113/atoll.git#branch=zach-patches")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/atoll"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -S atoll -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
